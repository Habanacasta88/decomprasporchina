---
// src/components/widgets/ZapatosWidget.astro
import ZapatosIsland from './ZapatosWidget.tsx';
import { aliexpress } from '../../lib/afiliados';
---

<div class="zapatos-widget-wrapper">
  <noscript>
    <p class="zapatos-widget__noscript">
      Esta calculadora necesita JavaScript. Consulta la tabla completa más abajo para conversiones CN ↔ EU ↔ US ↔ UK ↔ JP.
    </p>
  </noscript>
  <ZapatosIsland
    client:visible={{ rootMargin: '200px' }}
    aliexpressUrl={aliexpress()}
  />
</div>

<style is:global>
  .zapatos-widget {
    border-left: 4px solid var(--clr-amber);
    padding: 1.25rem 1rem;
    border-radius: var(--r-md);
    background: var(--clr-surface);
    box-shadow: var(--shadow-sm);
    min-height: 360px;
  }
  .zapatos-widget__title {
    font-family: var(--font-display); font-weight: 600; font-size: 1.25rem;
    margin: 0 0 1rem; color: var(--clr-red);
  }
  .zapatos-widget__row { display: flex; flex-direction: column; gap: .25rem; margin-bottom: .85rem; }
  .zapatos-widget__label { font-weight: 600; font-size: .9375rem; color: var(--clr-ink); }
  .zapatos-widget__select {
    font-family: var(--font-body); font-size: 1rem; min-height: 44px;
    padding: .55rem .75rem; border: 1px solid var(--clr-border);
    border-radius: var(--r-sm); background: #fff; color: var(--clr-ink);
  }
  .zapatos-widget__select:focus-visible {
    outline: 3px solid var(--clr-amber); outline-offset: 2px;
  }
  .zapatos-widget__output {
    display: block; margin-top: 1rem; padding: 1rem;
    background: var(--clr-amber-bg); border-radius: var(--r-sm);
  }
  .zapatos-widget__output.is-error {
    background: var(--clr-red-light); color: var(--clr-red);
  }
  .zapatos-widget__resultado {
    display: block; font-family: var(--font-display);
    font-size: 1.5rem; font-weight: 600; color: var(--clr-ink);
  }
  .zapatos-widget__cm {
    display: block; margin-top: .25rem;
    font-size: .9rem; color: var(--clr-muted);
  }
  .zapatos-widget__inline-cta {
    display: block; margin-top: 1rem; padding: .85rem 1.25rem;
    background: var(--clr-red); color: #fff; text-align: center;
    border-radius: var(--r-sm); font-weight: 600; text-decoration: none;
    min-height: 44px; box-sizing: border-box;
  }
  .zapatos-widget__inline-cta:hover { background: var(--clr-red-dark); color: #fff; }
  .zapatos-widget__noscript {
    background: var(--clr-surface2); padding: .75rem;
    border-radius: var(--r-sm);
  }
</style>
